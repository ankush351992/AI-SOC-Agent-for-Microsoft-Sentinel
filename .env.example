# ===============================================
# Microsoft Sentinel AI Triage Agent Configuration
# ===============================================

APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & Authentication
SECRET_KEY=generate-a-secure-random-256-bit-key-for-jwt-here
ADMIN_USERNAME=soc_admin
ADMIN_PASSWORD=SentinelAdmin2026!

# Standalone / Offline Simulation (set to false for live Azure connection)
DEMO_MODE=true

# Azure Microsoft Sentinel Settings
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_azure_service_principal_secret_here
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP_NAME=rg-sentinel-prod
AZURE_WORKSPACE_NAME=law-sentinel-prod
AZURE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
USE_MANAGED_IDENTITY=false

# LLM Engine Settings (Azure OpenAI or OpenAI)
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
MODEL_TEMPERATURE=0.1

# Optional Threat Intelligence API Keys
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Automation Controls
ENABLE_AUTO_POLLING=false
AUTO_POST_COMMENTS_TO_SENTINEL=true
AUTO_CLOSE_FALSE_POSITIVES=false
